# Local development can use SQLite by leaving DATABASE_URL blank.
DATABASE_URL=
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Razorpay TEST keys only. Leave blank to use demo payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP (Gmail example). Leave blank to skip sending real emails.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
